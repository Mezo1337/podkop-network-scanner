<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PodkopScanner</AssemblyName>
    <RootNamespace>PodkopScanner.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Podkop Network Scanner</Product>
    <AssemblyTitle>Podkop Network Scanner</AssemblyTitle>
    <Version>1.0.0</Version>
    <Copyright>Локальное приложение, без телеметрии</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodkopScanner.Core\PodkopScanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- WinDivert 2.2.2 (LGPLv3/GPLv2), x64: драйвер должен лежать рядом с exe. -->
    <None Include="..\..\native\x64\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\x64\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\WinDivert-LICENSE.txt" Link="licenses\WinDivert-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
